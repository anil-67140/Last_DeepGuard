PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/deepguard

# Supabase (get from supabase.com — free tier)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# AI Engine
# AI_ENGINE_URL=http://localhost:8000
# on windows
AI_ENGINE_URL=http://127.0.0.1:8000

# Frontend
FRONTEND_URL=http://localhost:5173

# ── FREE AI for Report Generation (choose one or more) ──

# Option 1: Groq — FREE, fast, no credit card needed
# Get key at: https://console.groq.com (completely free)
GROQ_API_KEY=your_groq_api_key_here

# Option 2: Ollama — 100% LOCAL, completely free
# Install from: https://ollama.ai then run: ollama pull llama3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Option 3: OpenAI — PAID (optional, not needed)
# OPENAI_API_KEY=sk-...

# ── FR-18: Bulk Processing Queue ──
# Optional. Without this, uploads are processed by an in-process queue
# (concurrency 2) — works fine for typical use, but jobs still waiting are
# lost if the server restarts. Set REDIS_URL for a persistent, Redis-backed
# queue (falls back to in-process automatically if Redis isn't reachable).
# Free option: https://upstash.com (serverless Redis, no local install)
# REDIS_URL=redis://default:PASSWORD@your-instance.upstash.io:6379
QUEUE_CONCURRENCY=2

# ── FR-19: Alert Notifications (email) ──
# Optional. Without SMTP_* set (and SMTP_DRY_RUN not "true"), email alerts are
# a logged no-op — in-dashboard alerts (Socket.IO) still work either way.
# Free option: a Gmail account with an "App Password" (myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.email@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM=DeepGuard <your.email@gmail.com>
# ALERT_EMAIL_TO=admin@example.com   # extra recipient (e.g. an admin mailbox), in addition to the uploader
# ALERT_EMAIL_MODE=all               # "all" (every completed job) or "critical_only"
SMTP_DRY_RUN=true                    # logs the email instead of sending — good for a first run/demo
APP_URL=http://localhost:5173        # used to build the "Open results" link in alert emails

# ── FR-20: Data Backup and Recovery ──
# BACKUP_DIR=./backups               # default: backend-node/backups
BACKUP_RETENTION_DAYS=30
BACKUP_CRON=0 2 * * *                # daily at 2:00 AM, per the spec
# BACKUP_ENABLED=false               # set to disable the scheduler (e.g. in tests)
